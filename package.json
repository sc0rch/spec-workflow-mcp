{
  "name": "@sc0rch/spec-workflow",
  "version": "2.2.6",
  "description": "CLI and desktop app for spec-driven development workflows",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sc0rch/spec-workflow.git"
  },
  "homepage": "https://github.com/sc0rch/spec-workflow#readme",
  "bugs": {
    "url": "https://github.com/sc0rch/spec-workflow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "spec-workflow": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-static",
    "copy-static": "node scripts/copy-static.cjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "desktop:install": "npm install --prefix apps/desktop",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:lint": "npm --prefix apps/desktop run lint",
    "desktop:test": "npm --prefix apps/desktop run test",
    "desktop:test:e2e": "npm --prefix apps/desktop run test:e2e",
    "desktop:package": "npm --prefix apps/desktop run package:dir",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build",
    "validate:mdx": "tsx scripts/validate-mdx.ts"
  },
  "keywords": [
    "spec-workflow",
    "cli",
    "electron",
    "ai-development",
    "development-workflow"
  ],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "chokidar": "^3.5.3",
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^22.18.1",
    "@vitest/coverage-v8": "^4.0.15",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.15"
  }
}
